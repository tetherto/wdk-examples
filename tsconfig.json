{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["shared/**/*.ts", "wallet-evm/**/*.ts", "wallet-evm-erc-4337/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
