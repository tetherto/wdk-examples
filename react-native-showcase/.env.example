# ── WDK Chain Providers ────────────────────────────────────────────────────────
# Refer to https://docs.wdk.tether.io/ for instructions on how to obtain these values.
EXPO_PUBLIC_BTC_PROVIDER=https://your-blockbook-instance.example.com
EXPO_PUBLIC_EVM_PROVIDER=https://mainnet.infura.io/v3/YOUR_API_KEY
EXPO_PUBLIC_EVM_BUNDLER_URL=https://your-bundler.example.com
EXPO_PUBLIC_EVM_PAYMASTER_URL=https://your-paymaster.example.com
EXPO_PUBLIC_TRON_PROVIDER=https://api.trongrid.io
EXPO_PUBLIC_TRON_GASFREE_PROVIDER=https://open.gasfree.io/tron
EXPO_PUBLIC_TRON_GASFREE_API_KEY=your-api-key
EXPO_PUBLIC_TRON_GASFREE_API_SECRET=your-api-secret


# ── Cloud Backup — iOS CloudKit ───────────────────────────────────────────────
# The CloudKit container identifier you created in Apple Developer portal.
# Format: iCloud.<your-bundle-id>
EXPO_PUBLIC_CLOUDKIT_CONTAINER_ID=your_cloudkit_conatiner_id

# API token from icloud.developer.apple.com/dashboard → API Tokens
# Type: "User authentication token (Web Services)"
EXPO_PUBLIC_CLOUDKIT_API_TOKEN=your_cloudkit_api_token


# ── Cloud Backup — Android Google Drive ───────────────────────────────────────
# Web Application OAuth Client ID from Google Cloud Console → Credentials.
# Must be the "Web client (auto created by Google Service)" type — NOT Android client.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_webclient_id


# ── Cloud Backup — Payload Encryption ─────────────────────────────────────────
# Passphrase used to encrypt the backup payload before uploading to CloudKit
# or Google Drive. The same passphrase decrypts it on restore.
# Use a strong, unique value. Never commit this file.
# This uses AES-256-GCM with scrypt key derivation (from @tetherto/wdk-utils).
EXPO_PUBLIC_CLOUD_BACKUP_PASSPHRASE=demo-passphrase